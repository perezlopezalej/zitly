# Supabase — URL del proyecto (obligatoria)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase — clave publishable/anon (obligatoria)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase — clave secret/service_role, salta RLS; solo servidor (obligatoria)
SUPABASE_SERVICE_ROLE_KEY=
# Secreto Bearer para /api/cron/reminders (obligatoria)
CRON_SECRET=
# Resend — API key para emails; si falta, los emails se omiten (opcional)
RESEND_API_KEY=
# URL pública de la app para enlaces de emails y reservas (opcional; por defecto http://localhost:3000)
NEXT_PUBLIC_APP_URL=
# Cloudflare Turnstile — site key del CAPTCHA en auth (opcional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
